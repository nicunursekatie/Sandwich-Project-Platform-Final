# ==============================================================================
# Firebase Migration Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values
# This replaces the Replit-specific .env configuration
# ==============================================================================

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================

# The public URL of your application (required for email links, SMS, etc.)
# Examples:
#   - Firebase Hosting: https://your-project.web.app
#   - Cloud Run: https://your-service-xyz.run.app
#   - Custom domain: https://app.yourdomain.com
PUBLIC_APP_URL=https://your-app-url.web.app

# Alternative: APP_URL (fallback if PUBLIC_APP_URL not set)
# APP_URL=https://your-app-url.web.app

# Node environment
NODE_ENV=production

# Server port (Cloud Run sets this automatically)
PORT=8080

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# PostgreSQL connection string (Neon, Supabase, Cloud SQL, etc.)
# Keep using your existing database - no migration needed!
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional: Separate URLs for production and development
# PRODUCTION_DATABASE_URL=postgresql://...
# DEV_DATABASE_URL=postgresql://...

# ==============================================================================
# FIREBASE CONFIGURATION (Server-Side)
# ==============================================================================

# Firebase Storage bucket name (e.g., your-project.appspot.com)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Firebase Service Account Key (base64 encoded JSON)
# To encode: base64 -w 0 service-account.json
# This is used for server-side Firebase Admin SDK operations
FIREBASE_SERVICE_ACCOUNT_KEY=base64-encoded-service-account-json

# Optional: Firebase project ID (usually auto-detected from service account)
# FIREBASE_PROJECT_ID=your-project-id

# ==============================================================================
# FIREBASE CONFIGURATION (Client-Side)
# ==============================================================================

# These VITE_ prefixed variables are exposed to the frontend
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=your-app-id

# ==============================================================================
# FILE STORAGE CONFIGURATION
# ==============================================================================

# Storage paths (compatible with both Replit and Firebase)
PUBLIC_STORAGE_PATHS=public
PRIVATE_STORAGE_DIR=private

# Legacy Replit variable names (for backward compatibility)
# PUBLIC_OBJECT_SEARCH_PATHS=public
# PRIVATE_OBJECT_DIR=private

# ==============================================================================
# SMS CONFIGURATION (Twilio)
# ==============================================================================

# SMS Provider: 'twilio' or 'phone_gateway'
SMS_PROVIDER=twilio

# Twilio credentials (direct API - no Replit connector needed)
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================================================
# EMAIL CONFIGURATION (SendGrid)
# ==============================================================================

SENDGRID_API_KEY=SG.xxxxxxxxxxxxxx
NOTIFICATION_FROM_EMAIL=noreply@yourdomain.org

# ==============================================================================
# AI INTEGRATIONS
# ==============================================================================

# OpenAI API key for AI features
AI_INTEGRATIONS_OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxx

# Anthropic API key for Claude vision features
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxx

# ==============================================================================
# REAL-TIME CHAT (Stream Chat)
# ==============================================================================

STREAM_API_KEY=your-stream-api-key
STREAM_API_SECRET=your-stream-api-secret

# ==============================================================================
# GOOGLE INTEGRATIONS
# ==============================================================================

# Google Sheets sync
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# MONITORING & ERROR TRACKING
# ==============================================================================

# Sentry error tracking (optional but recommended)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_RELEASE=sandwich-platform@1.0.0

# ==============================================================================
# SESSION CONFIGURATION
# ==============================================================================

# Session secret (generate a random string)
SESSION_SECRET=generate-a-random-string-here

# ==============================================================================
# OPTIONAL: PUSH NOTIFICATIONS
# ==============================================================================

# Firebase Cloud Messaging (optional)
# FCM_SERVER_KEY=your-fcm-server-key
# FCM_PROJECT_ID=your-fcm-project-id

# ==============================================================================
# NOTES FOR MIGRATION
# ==============================================================================
#
# Variables you NO LONGER NEED (Replit-specific):
# - REPLIT_DOMAIN
# - REPLIT_DOMAINS
# - REPLIT_DEPLOYMENT
# - REPLIT_ID
# - REPL_IDENTITY
# - WEB_REPL_RENEWAL
# - REPLIT_CONNECTORS_HOSTNAME
#
# The application will automatically detect the environment and use
# the appropriate configuration. You can keep Replit variables if you
# want to support both environments during the transition.
#
# ==============================================================================
